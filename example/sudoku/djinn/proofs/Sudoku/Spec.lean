/-! ## rel sameunit -/

def sameunit_pre (i : ℤ) (j : ℤ) : Prop :=
  (((0 ≤ i ∧ i < 81) ∧ 0 ≤ j) ∧ j < 81)

def sameunit_spec (i : ℤ) (j : ℤ) (b : Bool) : Prop :=
  sameunit_pre i j ∧
  (b = true ↔ (((i / 9) = (j / 9) ∨ (i % 9) = (j % 9)) ∨ ((i / 27) = (j / 27) ∧ ((i % 9) / 3) = ((j % 9) / 3))))

