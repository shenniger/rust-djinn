  (∀ i : ℤ, 0 ≤ i → i < 81 → (∀ j : ℤ, 0 ≤ j → j < 81 → ((i ≠ j ∧ sameunit_spec i j true) → c[i.toNat]! ≠ c[j.toNat]!)))

