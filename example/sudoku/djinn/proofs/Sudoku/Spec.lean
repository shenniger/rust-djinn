  prefixthen_pre g c i d ∧
  (h.length : ℤ) = 81 ∧
  (∀ j : ℤ, 0 ≤ j → j < i → h[j.toNat]! = c[j.toNat]!) ∧
  ((h[i.toNat]!).val : ℤ) = d ∧
