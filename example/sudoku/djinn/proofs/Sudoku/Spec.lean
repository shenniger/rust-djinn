/-! ## func digitof -/

def digitof_pre (ch : U8) : Prop :=
  True

def digitof_spec (ch : U8) (d : U8) : Prop :=
  digitof_pre ch ∧
  (d.val : ℤ) = (if (49 ≤ (ch.val : ℤ) ∧ (ch.val : ℤ) ≤ 57) then ((ch.val : ℤ) - 48) else 0 : ℤ)

/-! ## func parsepuzzle -/

def parsepuzzle_pre (s : List U8) : Prop :=
  (s.length : ℤ) = 81

def parsepuzzle_spec (s : List U8) (g : List U8) : Prop :=
  parsepuzzle_pre s ∧
  (g.length : ℤ) = 81 ∧
  (∀ i : ℤ, 0 ≤ i → i < 81 → digitof_spec s[i.toNat]! g[i.toNat]!)

/-! ## func digitchar -/

def digitchar_pre (d : U8) : Prop :=
  True

def digitchar_spec (d : U8) (ch : U8) : Prop :=
  digitchar_pre d ∧
  (ch.val : ℤ) = (if (d.val : ℤ) ≤ 9 then (48 + (d.val : ℤ)) else 63 : ℤ)

/-! ## func showgrid -/

def showgrid_pre (c : List U8) : Prop :=
  (c.length : ℤ) = 81

def showgrid_spec (c : List U8) (s : List U8) : Prop :=
  showgrid_pre c ∧
  (s.length : ℤ) = ((c.length : ℤ) + 1) ∧
  (∀ i : ℤ, 0 ≤ i → i < (c.length : ℤ) → digitchar_spec c[i.toNat]! s[i.toNat]!) ∧
  ((s[((c.length : ℤ) : ℤ).toNat]!).val : ℤ) = 10

