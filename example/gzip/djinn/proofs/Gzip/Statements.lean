/-- GUARANTEE: well-formedness and call sites — every partial operation is in
    its domain and every callee's precondition holds, wherever its side matters. -/
axiom block.wf :
    ∀ (s : List U8) (i : ℤ) (prev : List U8) (out : List U8) (j : ℤ),
      block_spec s i prev out j →
      ((field_pre s i 2)) ∧
      (¬(field_spec s i 2 0) → (field_pre s i 2)) ∧
      (¬(field_spec s i 2 0) → ¬(field_spec s i 2 1) → (field_pre s i 2))

