/-! ## func clamp -/

def clamp_pre (x : I32) (lo : I32) (hi : I32) : Prop :=
  lo.val ≤ hi.val

def clamp_spec (x : I32) (lo : I32) (hi : I32) (r : I32) : Prop :=
  clamp_pre x lo hi ∧
  (lo.val ≤ r.val ∧ r.val ≤ hi.val) ∧
  (x.val < lo.val → r = lo) ∧
  (x.val > hi.val → r = hi) ∧
  ((lo.val ≤ x.val ∧ x.val ≤ hi.val) → r = x)

/-! ## func count_negative -/

def count_negative_pre (v : List I32) : Prop :=
  True

def count_negative_spec (v : List I32) (r : Usize) : Prop :=
  count_negative_pre v ∧
  (r.val : ℤ) = (v.countP (fun y => decide (y.val < 0)) : ℤ)

/-! ## func min -/

def min_pre (a : I32) (b : I32) : Prop :=
  True

def min_spec (a : I32) (b : I32) (r : I32) : Prop :=
  min_pre a b ∧
  r.val ≤ a.val ∧
  r.val ≤ b.val ∧
  (r = a ∨ r = b)

/-! ## func max -/

def max_pre (a : I32) (b : I32) : Prop :=
  True

def max_spec (a : I32) (b : I32) (r : I32) : Prop :=
  max_pre a b ∧
  r.val ≥ a.val ∧
  r.val ≥ b.val ∧
  (r = a ∨ r = b)

